# Lumen Frontend Environment Variables

# Base URL for the FastAPI Backend API
# In local development, defaults to: http://localhost:8000/api/v1
# In production (when deployed to GitHub Pages or custom host), configure your deployed backend API URL:
# VITE_API_URL=https://api.yourdomain.com/api/v1

# Custom base path for Vite assets and routing (optional)
# Defaults to '/' in local dev and '/Lumen/' in production build:
# VITE_BASE_PATH=/Lumen/
